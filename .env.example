PORT=3000

# Pooler em modo transação (porta 6543). A API usa esta URL em runtime.
DATABASE_URL="postgresql://postgres.owmpwtblgsamndcczvmy:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pooler em modo sessão (porta 5432). O Prisma Migrate usa esta URL.
DIRECT_URL="postgresql://postgres.owmpwtblgsamndcczvmy:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres"

# Segredo usado para assinar os tokens JWT. Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=1d
