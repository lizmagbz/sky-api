{
  "name": "sky-api",
  "version": "1.0.0",
  "description": "API REST em Node.js com Clean Architecture, Prisma e Supabase Auth",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
